logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# ============================================
# Arduino directories - exclude most content
# ============================================

# Exclude ALL board managers and libraries (including ESP32)
# Developers will download the ESP32 board manager through the app's Boards Manager
arduino/data/packages/*
arduino/user/libraries/*
arduino/downloads/*
arduino/data/tmp/*

# Keep Arduino index files (needed for package/library updates)
!arduino/data/*.json
!arduino/data/*.json.sig
!arduino/data/*.yaml

# Keep config directory structure
!arduino/config/

